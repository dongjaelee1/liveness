# Logical paths. The copy of the Ordinal library (ordinal/) and HeapLang (lantana_heap_lang/)
# are outside lantana/, but in the [lantana] namespace.
-Q ordinal lantana.ordinal
-Q lantana lantana
-Q lantana_heap_lang lantana.heap_lang

# Custom flags.
# We sometimes want to locally override notation, and there is no good way to do that with scopes.
-arg -w -arg -notation-overridden
# Cannot use non-canonical projections as it causes massive unification failures
# (https://github.com/coq/coq/issues/6294).
-arg -w -arg -redundant-canonical-projection
# Warning seems incorrect, see https://gitlab.mpi-sws.org/iris/stdpp/-/issues/216
-arg -w -arg -notation-incompatible-prefix
# Some files (mostly the Ordinal copy) still use the deprecated [Coq] prefix for the standard library.
-arg -w -arg -deprecated-from-Coq
-arg -w -arg -deprecated-dirpath-Coq

