#!/bin/bash
set -e

NJOBS="${NJOBS:-8}"

# Opam repository for Coq packages.
opam repo add coq-released https://coq.inria.fr/opam/released

# Coq (Rocq) and the Ordinal library.
opam remote add coq-sf -k git --rank=1 https://github.com/snu-sf/sf-opam-coq-archive
opam install -y coq.9.0.0 coq-ordinal.0.5.6

# Build and install the bundled std++, parametric Iris, and transfinite Iris
# developments (shipped as zip files in the repository root). These are built
# from the bundled sources so that no access to their upstream repositories is
# needed.
rm -rf vendor
mkdir -p vendor
unzip -q stdpp.zip -d vendor
unzip -q iris-parametric-index.zip -d vendor
unzip -q transfinite-parametric-index.zip -d vendor

make -C vendor/stdpp -j"$NJOBS"
make -C vendor/stdpp install

make -C vendor/iris-parametric-index -j"$NJOBS"
make -C vendor/iris-parametric-index install

make -C vendor/transfinite-parametric-index -j"$NJOBS"
make -C vendor/transfinite-parametric-index install
